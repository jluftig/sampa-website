# Supabase — copy this file to .env.local and fill in your project's values.
# Both are safe to expose in the browser; access is protected by Row-Level Security.
# Find them in Supabase: Connect button (top bar) or Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server only (Vercel). Never prefix these with VITE_.
# BREVO_LIST_DAILY_NEWS=          # Brevo list id for the daily roundup. Josh creates the list; it does not exist yet.
# BREVO_DOI_TEMPLATE_ID_DAILY=    # Optional. Falls back to BREVO_DOI_TEMPLATE_ID.
